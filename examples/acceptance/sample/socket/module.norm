Module module() {
  return module(
    name: "sample.socket",
    version: 1,
    dependencies: [
      dependency(repository: "github", name: "micronaut.websocket", version: 2),
      dependency(repository: "github", name: "micronaut.core", version: 4),
      dependency(repository: "github", name: "micronaut.http", version: 4),
      dependency(repository: "github", name: "micronaut.inject", version: 4),
      dependency(repository: "github", name: "micronaut.runtime", version: 3),
      dependency(repository: "github", name: "micronaut.server.netty", version: 3),
      dependency(repository: "github", name: "micronaut.json", version: 3),
      dependency(repository: "github", name: "micronaut.jackson", version: 3),
      dependency(repository: "github", name: "micronaut.inject.processor", version: 4)
    ]
  )
}
